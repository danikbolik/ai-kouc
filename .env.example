# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Strava OAuth
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
NEXT_PUBLIC_STRAVA_CLIENT_ID=
# Produkce (Vercel):
STRAVA_REDIRECT_URI=https://ai-kouc-five.vercel.app/api/strava/callback
